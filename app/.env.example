# Copie este arquivo para ".env" (mesma pasta) e preencha.
# O .env é ignorado pelo Git: a chave NUNCA deve ser commitada nem colada no chat.

# Chave da GroqCloud (console.groq.com -> API Keys). Lida só pelo servidor.
GROQ_API_KEY=

# Modelo aberto hospedado na Groq (opcional). Em out/2026 não há Llama de conversa na Groq.
GROQ_MODEL=openai/gpt-oss-120b

# Chave secreta do identificador de CPF/CNPJ (HMAC). No emulador local NÃO é necessária
# (o servidor usa uma chave fixa de desenvolvimento). No site publicado, cadastre uma
# sequência longa e aleatória nas variáveis de ambiente do Netlify e use a MESMA chave ao
# carregar os dados fictícios (scripts/seed-emulator.mjs --demo). Se a chave mudar, os
# índices de CPF/CNPJ já gravados deixam de valer.
DOCUMENTO_HMAC_KEY=
