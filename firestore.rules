// ============================================================================
//  Regras de segurança do Firestore — GastroMatch
//
//  Valem para o emulador local e são a base para produção. Princípios:
//  - nada é permitido por padrão (o que não está escrito aqui é negado);
//  - cada usuário só altera os próprios dados; admin tem poderes limitados;
//  - ficha privada (usuarios) separada da ficha pública do restaurante (restaurantes);
//    o endereço da página (slug) é único;
//  - CPF/CNPJ ficam em subcoleção privada (só o dono lê; nem o suporte);
//  - "chaves primárias" por ID de documento: 1 CPF/CNPJ por conta,
//    1 avaliação por cliente/alvo, 1 resgate por cliente/cupom, 1 favorito por
//    cliente/restaurante, código único de ingresso, código de cupom único por restaurante;
//  - promoções têm vigência por datas; cupom vinculado só vale com a promoção ativa;
//  - textos não aceitam < > " ` (bloqueia injeção de HTML nas páginas antigas).
//
//  Testes automatizados: app/tests/regras.test.js (npm run test:regras).
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quem é quem ----------
    function logado() { return request.auth != null; }
    function meuUid() { return request.auth.uid; }
    // Caminho de um documento: coleção e ID separados (um "$( )" só vale para UM segmento).
    function doc(colecao, id) { return /databases/$(database)/documents/$(colecao)/$(id); }
    function admin() { return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function meuPerfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function contaAtiva() { return temPerfil() && meuPerfil().get('status', 'ativo') == 'ativo'; }
    function cliente() { return contaAtiva() && meuPerfil().tipo == 'cliente'; }
    function restaurante() { return contaAtiva() && meuPerfil().tipo == 'restaurante'; }

    // ---------- validação de dados ----------
    // (?s) faz o "." aceitar quebras de linha: sem isso, "linha\n<script>" passaria.
    function texto(v, max) { return v is string && v.size() <= max && !v.matches('(?s).*[<>"`].*'); }
    function textoOpc(d, campo, max) { return !(campo in d) || d[campo] == null || texto(d[campo], max); }
    function numeroOpc(d, campo, min, max) { return !(campo in d) || d[campo] == null || (d[campo] is number && d[campo] >= min && d[campo] <= max); }
    function listaOpc(d, campo, max) { return !(campo in d) || (d[campo] is list && d[campo].size() <= max); }
    // Datas no formato AAAA-MM-DD (comparar o texto equivale a comparar as datas).
    function dataISO(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function dataOpc(d, campo) { return !(campo in d) || d[campo] == null || d[campo] == '' || dataISO(d[campo]); }
    function dois(n) { return n < 10 ? '0' + string(n) : string(n); }
    // Data de hoje no horário de Brasília (UTC-3), no formato AAAA-MM-DD.
    function hoje() {
      let t = request.time - duration.value(3, 'h');
      return string(t.year()) + '-' + dois(t.month()) + '-' + dois(t.day());
    }
    function inalterados(campos) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    function soAlterou(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // ============================================================ usuarios (ficha PRIVADA)
    // Perfil do cliente e do RESPONSÁVEL pelo restaurante: e-mail, nome, telefone pessoal.
    // Só o dono e o admin leem. Os dados públicos do estabelecimento ficam em "restaurantes".
    // CPF/CNPJ NÃO ficam aqui (subcoleção "privado").
    function camposPerfil() {
      return ['email', 'tipo', 'status', 'nome', 'nomeResponsavel', 'telefone', 'criadoEm', 'aceiteTermosEm', 'atualizadoEm',
              'excluidoEm', 'banidoEm', 'motivoBanimento'];
    }
    function perfilValido(d) {
      return d.keys().hasOnly(camposPerfil())
        && textoOpc(d, 'nome', 120) && textoOpc(d, 'nomeResponsavel', 120) && textoOpc(d, 'telefone', 30);
    }

    match /usuarios/{id} {
      // Nenhum perfil é público: nem o do cliente, nem o do responsável pelo restaurante.
      allow read: if (logado() && meuUid() == id) || admin();

      allow create: if logado() && meuUid() == id
        && request.resource.data.tipo in ['cliente', 'restaurante']
        && request.resource.data.status == 'ativo'
        && request.resource.data.email == request.auth.token.email
        && perfilValido(request.resource.data)
        // Conta de restaurante nasce junto com a ficha pública do estabelecimento (mesma gravação).
        && (request.resource.data.tipo != 'restaurante' || existsAfter(doc('restaurantes', id)));

      // Dono: não muda tipo nem e-mail; só pode mudar o status para "excluido".
      allow update: if logado() && meuUid() == id
        && inalterados(['tipo', 'email', 'criadoEm', 'banidoEm', 'motivoBanimento'])
        && (request.resource.data.get('status', 'ativo') == resource.data.get('status', 'ativo')
            || request.resource.data.status == 'excluido')
        && perfilValido(request.resource.data);

      // Admin: moderação (banir, restaurar, excluir); nada mais.
      allow update: if admin()
        && soAlterou(['status', 'banidoEm', 'motivoBanimento', 'excluidoEm']);

      allow delete: if logado() && meuUid() == id;

      // Dados sensíveis (CPF/CNPJ): somente o próprio usuário. Nem o suporte lê.
      match /privado/{docId} {
        allow read: if logado() && meuUid() == id;
        allow create, update: if logado() && meuUid() == id
          && request.resource.data.keys().hasOnly(['cpf', 'cnpj'])
          && (!('cpf' in request.resource.data) || request.resource.data.cpf.matches('^[0-9]{11}$'))
          && (!('cnpj' in request.resource.data) || request.resource.data.cnpj.matches('^[0-9]{14}$'));
        allow delete: if logado() && meuUid() == id;
      }
    }

    // ============================================================ restaurantes (ficha PÚBLICA)
    // Dados do estabelecimento que qualquer visitante pode ver. O ID é o uid do responsável.
    // Não guarda e-mail, nome nem telefone pessoal do responsável.
    function camposRestaurante() {
      return ['donoUid', 'slug', 'status', 'destaque', 'nomeRestaurante', 'cozinha', 'vibes', 'ocasioes', 'faixaPreco',
              'estado', 'cidade', 'bairro', 'endereco', 'lat', 'lng', 'telefone', 'whatsapp', 'descricao', 'fotos', 'foto',
              'diasSemana', 'inicioSemana', 'fimSemana', 'diasFim', 'inicioFds', 'fimFds', 'criadoEm', 'atualizadoEm'];
    }
    // Slug: letras minúsculas, números e hífens, de 3 a 60 caracteres.
    function slugValido(v) { return v is string && v.size() >= 3 && v.size() <= 60 && v.matches('^[a-z0-9]+(-[a-z0-9]+)*$'); }
    function restauranteValido(id, d) {
      return d.keys().hasOnly(camposRestaurante())
        && d.donoUid == id
        && texto(d.nomeRestaurante, 120) && textoOpc(d, 'cozinha', 40)
        && textoOpc(d, 'estado', 2) && textoOpc(d, 'cidade', 80) && textoOpc(d, 'bairro', 80)
        && textoOpc(d, 'endereco', 200) && textoOpc(d, 'descricao', 1000)
        && textoOpc(d, 'telefone', 30) && textoOpc(d, 'whatsapp', 30)
        && textoOpc(d, 'diasSemana', 40) && textoOpc(d, 'diasFim', 40)
        && numeroOpc(d, 'faixaPreco', 1, 4) && listaOpc(d, 'vibes', 3) && listaOpc(d, 'ocasioes', 10) && listaOpc(d, 'fotos', 10)
        // Slug único: depois da gravação, o índice do slug aponta para ESTE restaurante.
        && slugValido(d.slug)
        && getAfter(doc('slugs', d.slug)).data.restauranteId == id;
    }

    match /restaurantes/{id} {
      allow read: if true;

      // Criação: só o próprio responsável, com conta do tipo restaurante (que pode estar nascendo na mesma gravação).
      allow create: if logado() && meuUid() == id
        && getAfter(doc('usuarios', id)).data.tipo == 'restaurante'
        && getAfter(doc('usuarios', id)).data.get('status', 'ativo') == 'ativo'
        && request.resource.data.status == 'ativo'
        && request.resource.data.get('destaque', false) == false
        && restauranteValido(id, request.resource.data);

      // Dono: edita os dados do estabelecimento, mas não o status de moderação nem o destaque.
      allow update: if restaurante() && meuUid() == id
        && inalterados(['donoUid', 'status', 'destaque', 'criadoEm'])
        && restauranteValido(id, request.resource.data);

      // Admin: só moderação (status) e destaque.
      allow update: if admin() && soAlterou(['status', 'destaque']);

      allow delete: if admin() || (logado() && meuUid() == id);
    }

    // Índice do slug (chave única): ID = o próprio slug. Não existe "update":
    // um slug que já tem dono não pode ser tomado por outro restaurante.
    match /slugs/{slug} {
      allow read: if true;
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['restauranteId'])
        && request.resource.data.restauranteId == meuUid()
        && getAfter(doc('restaurantes', meuUid())).data.slug == slug;
      // Só libera o slug se, depois da gravação, o restaurante não existir mais ou usar outro slug.
      allow delete: if admin() || (logado() && resource.data.restauranteId == meuUid()
        && (!existsAfter(doc('restaurantes', meuUid())) || getAfter(doc('restaurantes', meuUid())).data.slug != slug));
    }

    // Índice de unicidade de CPF/CNPJ: o ID é um hash do documento. Como só existe
    // "create" (sem update), um segundo cadastro com o mesmo CPF/CNPJ é recusado.
    match /documentos/{hash} {
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'tipo'])
        && request.resource.data.uid == meuUid()
        && request.resource.data.tipo in ['cpf', 'cnpj'];
      allow delete: if admin() || (logado() && resource.data.uid == meuUid());
    }

    // Lista de administradores (definida fora do app; ninguém escreve pelo cliente).
    match /admins/{id} {
      allow read: if logado() && meuUid() == id;
    }

    // ============================================================ conteúdo dos restaurantes
    function donoDoNovo() { return restaurante() && request.resource.data.restauranteId == meuUid(); }
    function donoAtual() { return restaurante() && resource.data.restauranteId == meuUid(); }

    match /menus/{id} {
      allow read: if true;
      allow create, update: if donoDoNovo()
        && (resource == null || resource.data.restauranteId == meuUid())
        && request.resource.data.keys().hasOnly(['restauranteId', 'restaurante', 'cozinha', 'titulo', 'categoria', 'preco', 'imagem', 'descricao', 'criadoEm', 'importadoEm'])
        && texto(request.resource.data.titulo, 120) && texto(request.resource.data.categoria, 60)
        && request.resource.data.preco is number && request.resource.data.preco >= 0 && request.resource.data.preco <= 100000
        && textoOpc(request.resource.data, 'descricao', 1000) && textoOpc(request.resource.data, 'restaurante', 120);
      allow delete: if donoAtual() || admin();
    }

    // Promoção: vigência por datas (inicio/fim) e encerramento manual (encerradaEm).
    // O status (agendada, ativa, expirada, encerrada) NÃO é gravado: é calculado pelas datas.
    function promocaoAtiva(p) {
      return p.get('encerradaEm', null) == null
        && (p.get('inicio', '') == '' || p.inicio <= hoje())
        && (p.get('fim', '') == '' || p.fim >= hoje());
    }
    function vigenciaValida(d, criando) {
      return dataOpc(d, 'inicio') && dataOpc(d, 'fim')
        // Na criação as duas datas são obrigatórias.
        && (!criando || (dataISO(d.get('inicio', '')) && dataISO(d.get('fim', ''))))
        // A data final não pode ser anterior à inicial.
        && (!(dataISO(d.get('inicio', '')) && dataISO(d.get('fim', ''))) || d.fim >= d.inicio)
        && (d.get('encerradaEm', null) == null || d.encerradaEm is timestamp);
    }

    match /promocoes/{id} {
      allow read: if true;
      allow create, update: if donoDoNovo()
        && (resource == null || resource.data.restauranteId == meuUid())
        && request.resource.data.keys().hasOnly(['restauranteId', 'restaurante', 'cozinha', 'evento', 'titulo', 'descricao', 'prato', 'valorPromocional', 'diasValidos', 'horaInicio', 'horaFim', 'criadoEm', 'foto', 'imagem', 'inicio', 'fim', 'encerradaEm'])
        && texto(request.resource.data.titulo, 120) && textoOpc(request.resource.data, 'descricao', 1000)
        && textoOpc(request.resource.data, 'prato', 120) && textoOpc(request.resource.data, 'valorPromocional', 60)
        && textoOpc(request.resource.data, 'evento', 120)
        && vigenciaValida(request.resource.data, resource == null);
      allow delete: if donoAtual() || admin();
    }

    // Código do cupom: maiúsculas, números, hífen e sublinhado (vira parte da chave do índice).
    function codigoCupomValido(c) { return c is string && c.matches('^[A-Z0-9_-]{3,30}$'); }
    // Código único por restaurante: depois da gravação, o índice do código aponta para ESTE cupom.
    function codigoCupomUnico(id, d) {
      return getAfter(doc('codigosCupom', d.restauranteId + '_' + d.codigo)).data.cupomId == id;
    }
    // Vínculo opcional com uma promoção: ela precisa existir e ser do mesmo restaurante.
    function vinculoPromocaoValido(d) {
      return !('promocaoId' in d)
        || (d.promocaoId is string && get(doc('promocoes', d.promocaoId)).data.restauranteId == meuUid());
    }

    match /cupons/{id} {
      allow read: if true;
      // Restaurante cria/edita os próprios cupons, mas não mexe no contador de resgates.
      allow create: if donoDoNovo()
        && request.resource.data.keys().hasOnly(['restauranteId', 'restaurante', 'codigo', 'desconto', 'validadeInicio', 'validadeFim', 'horaInicio', 'horaFim', 'diasValidos', 'condicoes', 'prato', 'criadoEm', 'limiteTotal', 'resgatados', 'promocaoId'])
        && codigoCupomValido(request.resource.data.codigo) && textoOpc(request.resource.data, 'desconto', 60)
        && textoOpc(request.resource.data, 'condicoes', 500)
        && numeroOpc(request.resource.data, 'limiteTotal', 1, 100000)
        && request.resource.data.get('resgatados', 0) == 0
        && codigoCupomUnico(id, request.resource.data)
        && vinculoPromocaoValido(request.resource.data);
      allow update: if donoAtual() && request.resource.data.restauranteId == meuUid()
        && request.resource.data.get('resgatados', 0) == resource.data.get('resgatados', 0)
        && codigoCupomValido(request.resource.data.codigo) && textoOpc(request.resource.data, 'condicoes', 500)
        && numeroOpc(request.resource.data, 'limiteTotal', 1, 100000)
        && codigoCupomUnico(id, request.resource.data)
        && vinculoPromocaoValido(request.resource.data);
      // Cliente resgatando: só soma 1 ao contador, respeita o limite e precisa criar o
      // resgate dele na mesma transação (o resgate ainda não podia existir antes).
      allow update: if cliente()
        && soAlterou(['resgatados'])
        && request.resource.data.resgatados == resource.data.get('resgatados', 0) + 1
        && (resource.data.get('limiteTotal', null) == null || request.resource.data.resgatados <= resource.data.limiteTotal)
        && !exists(doc('resgates', id + '_' + meuUid()))
        && existsAfter(doc('resgates', id + '_' + meuUid()));
      allow delete: if donoAtual() || admin();
    }

    // Índice do código do cupom (chave única por restaurante): ID "uid_CODIGO".
    // Não existe "update": um código que já tem dono não pode ser tomado por outro cupom.
    match /codigosCupom/{chave} {
      allow get: if true;
      allow create: if restaurante()
        && request.resource.data.keys().hasOnly(['cupomId'])
        && getAfter(doc('cupons', request.resource.data.cupomId)).data.restauranteId == meuUid()
        && chave == meuUid() + '_' + getAfter(doc('cupons', request.resource.data.cupomId)).data.codigo;
      // Só libera o código se, depois da gravação, o cupom não existir mais ou tiver outro código.
      allow delete: if admin() || (restaurante() && chave.split('_')[0] == meuUid()
        && (resource == null
            || !existsAfter(doc('cupons', resource.data.cupomId))
            || meuUid() + '_' + getAfter(doc('cupons', resource.data.cupomId)).data.codigo != chave));
    }

    // Participar de evento da plataforma: o restaurante só pode se acrescentar na lista.
    function soSeAcrescentou() {
      return soAlterou(['restaurantesParticipantes'])
        && request.resource.data.restaurantesParticipantes.toSet()
           == resource.data.get('restaurantesParticipantes', []).toSet().union([meuUid()].toSet());
    }

    match /eventos/{id} {
      allow read: if true;
      allow create, update: if donoDoNovo()
        && (resource == null || resource.data.restauranteId == meuUid())
        && request.resource.data.get('tipoEvento', '') != 'geral_plataforma'
        && request.resource.data.keys().hasOnly(['restauranteId', 'restauranteNome', 'cozinha', 'titulo', 'foto', 'imagem', 'inicio', 'fim', 'diasValidos', 'horaInicio', 'horaFim', 'descricao', 'criadoEm'])
        && texto(request.resource.data.titulo, 120) && textoOpc(request.resource.data, 'descricao', 1000);
      allow update: if restaurante() && resource.data.get('tipoEvento', '') == 'geral_plataforma' && soSeAcrescentou();
      allow create, update, delete: if admin();
      allow delete: if donoAtual();
    }

    match /configuracoes/{id} {
      allow read: if true;
      allow write: if admin();
      allow update: if restaurante() && id == 'super_evento' && soSeAcrescentou();
    }

    // ============================================================ ações dos clientes
    // Itens salvos (promoções e eventos): só o próprio cliente lê. O documento não guarda
    // e-mail nem nome do cliente, e o restaurante não tem acesso a quem salvou.
    match /salvos/{id} {
      allow read: if logado() && (resource.data.usuarioId == meuUid() || admin());
      allow create: if cliente()
        && request.resource.data.usuarioId == meuUid()
        && request.resource.data.keys().hasOnly(['usuarioId', 'promocaoId', 'eventoId', 'titulo', 'descricao', 'foto', 'restauranteId', 'restauranteNome', 'dataResgate', 'valor', 'inicio', 'fim'])
        && texto(request.resource.data.titulo, 200) && textoOpc(request.resource.data, 'descricao', 1000)
        && textoOpc(request.resource.data, 'restauranteNome', 120);
      allow delete: if logado() && (resource.data.usuarioId == meuUid() || admin());
    }

    // Favoritos: ID uid_restauranteId garante um favorito por cliente para cada restaurante.
    // Sem e-mail nem nome do cliente, e só o próprio cliente lê: o restaurante não sabe quem o favoritou.
    match /favoritos/{id} {
      allow read: if logado() && resource.data.usuarioId == meuUid();
      allow create, update: if cliente()
        && request.resource.data.keys().hasOnly(['usuarioId', 'restauranteId', 'criadoEm'])
        && request.resource.data.usuarioId == meuUid()
        && request.resource.data.restauranteId is string
        && id == meuUid() + '_' + request.resource.data.restauranteId
        && exists(doc('restaurantes', request.resource.data.restauranteId));
      allow delete: if logado() && resource.data.usuarioId == meuUid();
    }

    // Resgate de cupom = "ingresso": ID cupomId_uid (1 por cliente), código único.
    match /resgates/{id} {
      // resource == null: a transação do resgate consulta "já resgatei?" antes de o documento existir.
      allow read: if logado() && (resource == null || resource.data.usuarioId == meuUid() || resource.data.restauranteId == meuUid() || admin());
      allow create: if cliente()
        && id == request.resource.data.cupomId + '_' + meuUid()
        && request.resource.data.keys().hasOnly(['cupomId', 'usuarioId', 'usuarioNome', 'restauranteId', 'restauranteNome', 'codigo', 'codigoCupom', 'desconto', 'condicoes', 'validadeFim', 'status', 'criadoEm'])
        && request.resource.data.usuarioId == meuUid()
        && request.resource.data.status == 'ativo'
        && request.resource.data.codigo.matches('^[A-Z0-9]{10}$')
        && request.resource.data.restauranteId == get(doc('cupons', request.resource.data.cupomId)).data.restauranteId
        // Cupom vinculado a uma promoção: só pode ser resgatado enquanto ela existir e estiver ativa.
        && (!('promocaoId' in get(doc('cupons', request.resource.data.cupomId)).data)
            || promocaoAtiva(get(doc('promocoes', get(doc('cupons', request.resource.data.cupomId)).data.promocaoId)).data))
        && textoOpc(request.resource.data, 'usuarioNome', 60)
        && existsAfter(doc('codigosResgate', request.resource.data.codigo))
        && getAfter(doc('cupons', request.resource.data.cupomId)).data.resgatados
           == get(doc('cupons', request.resource.data.cupomId)).data.get('resgatados', 0) + 1;
      // Só o restaurante dono valida, e só uma vez (ativo -> usado).
      allow update: if restaurante()
        && resource.data.restauranteId == meuUid()
        && resource.data.status == 'ativo'
        && request.resource.data.status == 'usado'
        && soAlterou(['status', 'usadoEm']);
    }

    // Índice do código do resgate (chave única). Ler um código exige conhecê-lo.
    match /codigosResgate/{codigo} {
      allow get: if logado();
      allow create: if cliente()
        && request.resource.data.keys().hasOnly(['resgateId'])
        && existsAfter(doc('resgates', request.resource.data.resgateId))
        && getAfter(doc('resgates', request.resource.data.resgateId)).data.codigo == codigo
        && getAfter(doc('resgates', request.resource.data.resgateId)).data.usuarioId == meuUid();
    }

    // Avaliações: ID alvoId_uid garante uma por cliente para cada restaurante/prato.
    function avaliacaoValida(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['alvo', 'alvoId', 'restauranteId', 'usuarioId', 'nomeExibicao', 'nota', 'comentario', 'tituloPrato', 'criadoEm', 'atualizadoEm'])
        && id == d.alvoId + '_' + meuUid()
        && d.usuarioId == meuUid()
        && d.alvo in ['restaurante', 'prato']
        && d.nota is int && d.nota >= 1 && d.nota <= 5
        && texto(d.nomeExibicao, 40) && textoOpc(d, 'comentario', 500) && textoOpc(d, 'tituloPrato', 120)
        && (d.alvo == 'restaurante'
            ? d.alvoId == d.restauranteId && exists(doc('restaurantes', d.restauranteId))
            : get(doc('menus', d.alvoId)).data.restauranteId == d.restauranteId);
    }
    match /avaliacoes/{id} {
      allow read: if true;
      allow create: if cliente() && avaliacaoValida(id);
      allow update: if cliente() && resource.data.usuarioId == meuUid() && avaliacaoValida(id);
      allow delete: if logado() && (resource.data.usuarioId == meuUid() || admin());
    }

    // Fale conosco: qualquer pessoa envia; só o suporte lê.
    match /contatos_suporte/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'email', 'assunto', 'mensagem', 'data', 'criadoEm', 'usuarioId'])
        && texto(request.resource.data.nome, 100)
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s<>"]+@[^@\\s<>"]+\\.[^@\\s<>"]+$') && request.resource.data.email.size() <= 120
        && texto(request.resource.data.assunto, 120)
        && texto(request.resource.data.mensagem, 2000) && request.resource.data.mensagem.size() >= 10
        && (!('usuarioId' in request.resource.data) || (logado() && request.resource.data.usuarioId == meuUid()));
      allow read, delete: if admin();
    }
  }
}
